# Copy to .env and fill in. Never commit .env.

# --- Hub ---
# Public URL the devices and dashboard use (https in production)
HUB_PUBLIC_URL=http://localhost:8787
HUB_PORT=8787
# Owner login for the dashboard
OWNER_PASSPHRASE=change-me
# Random string, 32+ chars, signs owner session cookies
SESSION_SECRET=change-me-to-a-long-random-string

# --- Gemini (used only by the hub) ---
GEMINI_API_KEY=
# Pick current model IDs at build time
GEMINI_MODEL_LITE=
GEMINI_MODEL_FLASH=
GEMINI_MODEL_PRO=

# --- Tiger Data (Postgres + TimescaleDB). Empty = in-memory store ---
DATABASE_URL=
# Tiger Data password (Tiger console -> service -> Reset password). Kept separate;
# the hub merges it into DATABASE_URL, so special characters are fine here.
DATABASE_PASSWORD=

# --- Papiers (read-only research context via the papiers CLI; Settings -> API tokens) ---
PAPIERS_TOKEN=

# --- Web worker (worker-web/) ---
# Hub the worker connects to; token is saved to worker-web/.device.json after pairing
WORKER_HUB_URL=http://localhost:8787

# --- Vultr (deploy, T5) ---
# Public IPv4 of the Vultr server, filled in once the server exists
VULTR_SERVER_IP=
# Optional: your own domain pointed at the server (e.g. from GoDaddy). Empty = use <ip>.sslip.io
HUB_DOMAIN=
