# Copy to .env and fill in. Never commit .env.

# --- Hub ---
# Public URL the devices and dashboard use (https in production)
HUB_PUBLIC_URL=http://localhost:8787
HUB_PORT=8787
# Owner login for the dashboard
OWNER_PASSPHRASE=change-me
# Random string, 32+ chars, signs owner session cookies
SESSION_SECRET=change-me-to-a-long-random-string

# --- Gemini (used only by the hub) ---
GEMINI_API_KEY=
# Pick current model IDs at build time
GEMINI_MODEL_LITE=
GEMINI_MODEL_FLASH=
GEMINI_MODEL_PRO=

# --- Tiger Data (Postgres + TimescaleDB). Empty = in-memory store ---
DATABASE_URL=

# --- Papiers (research findings). Exact vars to confirm from https://papiers.ai/docs ---
PAPIERS_API_KEY=

# --- Web worker (worker-web/) ---
# Hub the worker connects to; token is saved to worker-web/.device.json after pairing
WORKER_HUB_URL=http://localhost:8787
